# --- Database & Storage Persistence ---
# These folders contain your actual data and should not be in version control
mysql_data/
minio-data/

# --- Trino Specifics ---
# Trino generates logs and temporary files in its internal directory
trino/var/

# --- Superset Specifics ---
# Local home directory for Superset configs and logs
superset_home/

# --- Environment & Secrets ---
# If you eventually move passwords from docker-compose.yaml to an .env file
.env

# --- Python & Avro Artifacts ---
# For your healthcare Avro generation scripts and virtual environments
__pycache__/
*.py[cod]
venv/
.venv/
requirements-local.txt.bak

# --- System & IDE ---
.DS_Store
.vscode/
.idea/