# Healthcare Lakehouse - Environment Variables
# Copy this file to .env and adjust values as needed

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=healthcare

# --- MinIO ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# --- Superset ---
SUPERSET_SECRET_KEY=healthcare_2026_secret
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin

# --- Kafka (for local producers) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Trino (for local scripts) ---
TRINO_HOST=127.0.0.1
TRINO_PORT=8082
TRINO_USER=trino
TRINO_CATALOG=nessie
TRINO_SCHEMA=healthcare
